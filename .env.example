# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
# VITE_* values are bundled into the browser code and are public. Never put a secret in a VITE_ variable.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Show "Continue with Google" (enable the Google provider in Supabase first)
VITE_AUTH_GOOGLE=false

# Web Push: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# Optional
# SCRAPER_BASE_URL=http://127.0.0.1:8080
# PUSH_DISPATCH_IN_PROCESS=true
