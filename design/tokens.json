      "surface-muted": "#f1f4f2",
      "muted-foreground": "#5f6e66",
      "border": "#dce5df",
      "primary": "#087a50",
      "primary-hover": "#066a45",
      "primary-border": "#a9d3bf",
      "primary-foreground": "#ffffff",
      "accent": "#e5f2eb",
      "accent-foreground": "#075c3d",
      "ring": "#11835b",
      "destructive": "#b42318",
      "scrim": "rgba(13, 24, 19, 0.48)"
    },
    "dark": {
      "background": "#0f1714",
      "foreground": "#e6efe9",
      "card": "#17221d",
      "surface-muted": "#1d2a24",
      "muted-foreground": "#9fb3a7",
      "border": "#2c3d35",
      "primary": "#34b87e",
      "primary-hover": "#5cc996",
      "primary-border": "#2f6e53",
      "primary-foreground": "#04150d",
      "accent": "#1e3a2e",
      "accent-foreground": "#bfead3",
      "ring": "#4fd1a0",
      "destructive": "#f87171",
      "scrim": "rgba(0, 0, 0, 0.6)"
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 40
  },
  "layout": {
    "screen-margin": 16,
    "section-gap": 24,
    "row-min-height": 44,
    "touch-min": 44,
    "android-touch-min": 48
  },
  "radius": {
    "web": {
      "sm": 6,
      "md": 8,
      "pill": 999
    },
    "ios": {
      "control": 10,
      "card": 14,
      "sheet": 20,
      "pill": 999
    },
    "android": {
      "control": 20,
      "card": 12,
      "sheet": 28,
      "pill": 999
    }
  },
  "iconTiles": {
    "$description": "Settings icon tiles (DESIGN.md §2f). A vertical gradient from top to bottom, white glyph. Each row picks one by a stable hash of its title. Web also writes them as --tile-<name>-top/-bottom in src/index.css.",
    "blue": {
      "top": "#2563eb",
      "bottom": "#1e40af"
    },
    "orange": {
      "top": "#ea580c",
      "bottom": "#9a3412"
    },
    "violet": {
      "top": "#7c3aed",
      "bottom": "#5b21b6"
    },
    "pink": {
      "top": "#db2777",
      "bottom": "#9d174d"
    },
    "teal": {
      "top": "#0d9488",
      "bottom": "#115e59"
    },
    "amber": {
      "top": "#d97706",
      "bottom": "#92400e"
    },
    "rose": {
      "top": "#e11d48",
      "bottom": "#9f1239"
    },
    "indigo": {
      "top": "#4f46e5",
      "bottom": "#3730a3"
