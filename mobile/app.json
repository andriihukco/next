{
  "expo": {
    "name": "NEXTCOM",
    "slug": "eway-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eway.lviv"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокація показує вас на маршруті під час прогулянки."
        }
      ]
    ],
    "scheme": "eway",
    "experiments": {
      "typedRoutes": true
    }
  }
}
